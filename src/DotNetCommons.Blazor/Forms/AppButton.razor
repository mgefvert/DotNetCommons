@using Microsoft.AspNetCore.Components.Web
@inherits ComponentBase
<button type="@(Type == AppButtonType.Submit ? "submit" : "button")" disabled="@Disabled"
        class="@_buttonCss" title="@Description" @onclick="OnClick">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public AppButtonType Type { get; set; } = AppButtonType.Button;
    [Parameter] public AppButtonColor Color { get; set; } = AppButtonColor.Primary;
    [Parameter] public AppControlMode Mode { get; set; } = AppControlMode.Standard;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ButtonCss { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private readonly CssClassOverrides _buttonCss = new();

    protected override void OnParametersSet()
    {
        _buttonCss.Defaults = AppTheme.Button;
        _buttonCss.Overrides = ButtonCss;
        _buttonCss.State =
            (Mode == AppControlMode.Compact ? AppTheme.CompactButton : AppTheme.StandardButton) + ' ' +
            Color switch
            {
                AppButtonColor.Secondary => AppTheme.SecondaryButton,
                AppButtonColor.Warning   => AppTheme.WarningButton,
                _                        => AppTheme.PrimaryButton
            };
    }
}
