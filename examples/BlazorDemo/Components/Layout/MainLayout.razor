@inherits LayoutComponentBase
@inject IJSRuntime JS

<header class="app-header">
    <button class="theme-toggle" type="button" aria-pressed="@_isDarkMode" @onclick="ToggleDarkMode">
        Dark mode: @(_isDarkMode ? "On" : "Off")
    </button>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _isDarkMode = await JS.InvokeAsync<bool>("getDarkModeEnabled");
        StateHasChanged();
    }

    private async Task ToggleDarkMode()
    {
        await JS.InvokeVoidAsync("setDarkModeEnabled", _isDarkMode = !_isDarkMode);
    }
}
