@using System.Globalization

<svg class="block h-auto w-full" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <path d="@CreateArcPath(ArcStartAngle, ArcSweep, 0.95)" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="@GuideStrokeWidth" stroke-linecap="round" />
    @foreach (var tickMark in TickMarks)
    {
        <line x1="@tickMark.X1" y1="@tickMark.Y1" x2="@tickMark.X2" y2="@tickMark.Y2" stroke="currentColor" stroke-opacity="0.5" stroke-width="0.5" stroke-linecap="butt" />
    }

    @foreach (var segment in ValueSegments)
    {
        <path d="@segment.Path" fill="none" stroke="@segment.Color" stroke-width="1.5" stroke-linecap="butt" />
    }
</svg>

@code {
    private const double Radius = 50;
    private const int GradientSegmentCount = 100;
    private const double SegmentOverlapDegrees = 0.5;

    [Parameter] public double Minimum { get; set; } = 0;
    [Parameter] public double Maximum { get; set; } = 100;
    [Parameter] public double Value { get; set; } = 0;
    [Parameter] public double Tick { get; set; } = 10;
    [Parameter] public double OpeningDegrees { get; set; } = 90;
    [Parameter] public GaugeOpeningPosition OpeningPosition { get; set; } = GaugeOpeningPosition.Bottom;
    [Parameter] public double GuideThickness { get; set; } = 0.4;
    [Parameter] public string StartColor { get; set; } = "#16c7d5";
    [Parameter] public string EndColor { get; set; } = "#22c55e";

    private double EffectiveOpeningDegrees => double.IsFinite(OpeningDegrees)
        ? Math.Clamp(OpeningDegrees, 0, 360)
        : 45;

    private double OpeningCenterAngle => OpeningPosition switch
    {
        GaugeOpeningPosition.Top => 270,
        GaugeOpeningPosition.Right => 0,
        GaugeOpeningPosition.Left => 180,
        _ => 90
    };

    private double ArcStartAngle => OpeningCenterAngle + EffectiveOpeningDegrees / 2;
    private double ArcSweep => 360 - EffectiveOpeningDegrees;
    private double ValueFraction => HasValidRange && double.IsFinite(Value)
        ? Math.Clamp((Value - Minimum) / (Maximum - Minimum), 0, 1)
        : 0;
    private bool HasValidRange => double.IsFinite(Minimum) && double.IsFinite(Maximum) && Maximum > Minimum;
    private string GuideStrokeWidth => FormatNumber(GuideThickness);

    private IEnumerable<ArcSegment> ValueSegments
    {
        get
        {
            var segmentCount = (int)Math.Ceiling(ValueFraction * GradientSegmentCount);
            for (var index = 0; index < segmentCount; index++)
            {
                var startFraction = (double)index / GradientSegmentCount;
                var endFraction = Math.Min((double)(index + 1) / GradientSegmentCount, ValueFraction);
                var startAngle = ArcStartAngle + ArcSweep * startFraction;
                var endAngle = ArcStartAngle + ArcSweep * endFraction;
                var overlap = index > 0 ? SegmentOverlapDegrees : 0;
                if (endFraction < ValueFraction)
                    endAngle += SegmentOverlapDegrees;

                var midpoint = (startFraction + endFraction) / 2;
                yield return new ArcSegment(
                    CreateArcPath(startAngle - overlap, endAngle - startAngle + overlap, 1),
                    CreateGradientColor(midpoint));
            }
        }
    }

    private string ViewBox
    {
        get
        {
            if (ArcSweep <= 0)
                return "0 0 100 100";

            var angles = new List<double> { ArcStartAngle, ArcStartAngle + ArcSweep };
            foreach (var cardinalAngle in new[] { 0d, 90d, 180d, 270d })
            {
                if (IsAngleOnArc(cardinalAngle))
                    angles.Add(cardinalAngle);
            }

            var points = angles.Select(angle => PointAtAngle(angle, Radius)).ToArray();
            var padding = Math.Max(5, GuideThickness) / 2 + 1;
            var minX = points.Min(point => point.X) - padding;
            var minY = points.Min(point => point.Y) - padding;
            var width = points.Max(point => point.X) - minX + padding;
            var height = points.Max(point => point.Y) - minY + padding;
            return $"{FormatNumber(minX)} {FormatNumber(minY)} {FormatNumber(width)} {FormatNumber(height)}";
        }
    }

    private IEnumerable<TickMark> TickMarks
    {
        get
        {
            if (!HasValidRange || !double.IsFinite(Tick) || Tick <= 0 || ArcSweep <= 0)
                yield break;

            var tickValue = Minimum;
            while (tickValue <= Maximum)
            {
                var r = Radius * 0.95;
                var fraction = (tickValue - Minimum) / (Maximum - Minimum);
                var angle = ArcStartAngle + ArcSweep * fraction;
                var innerPoint = PointAtAngle(angle, r - 1.5);
                var outerPoint = PointAtAngle(angle, r - 0.75);
                yield return new TickMark(FormatNumber(innerPoint.X), FormatNumber(innerPoint.Y),
                                          FormatNumber(outerPoint.X), FormatNumber(outerPoint.Y));

                var nextTickValue = tickValue + Tick;
                if (nextTickValue <= tickValue)
                    yield break;

                tickValue = nextTickValue;
            }
        }
    }

    private string CreateArcPath(double startAngle, double sweep, double offset)
    {
        var r        = Radius * offset;
        var start    = PointAtAngle(startAngle, r);
        var end      = PointAtAngle(startAngle + sweep, r);
        var largeArc = sweep > 180 ? 1 : 0;
        return $"M {FormatNumber(start.X)} {FormatNumber(start.Y)} A {FormatNumber(r)} {FormatNumber(r)} 0 {largeArc} 1 {FormatNumber(end.X)} {FormatNumber(end.Y)}";
    }

    private string CreateGradientColor(double fraction)
    {
        var startColorPercent = (1 - fraction) * 100;
        return $"color-mix(in srgb, {StartColor} {FormatNumber(startColorPercent)}%, {EndColor})";
    }

    private bool IsAngleOnArc(double angle)
    {
        if (ArcSweep >= 360)
            return true;

        var distance = ((angle - ArcStartAngle) % 360 + 360) % 360;
        return distance <= ArcSweep;
    }

    private static (double X, double Y) PointAtAngle(double angle, double radius)
    {
        var radians = angle * Math.PI / 180;
        return (50 + radius * Math.Cos(radians), 50 + radius * Math.Sin(radians));
    }

    private static string FormatNumber(double number) => number.ToString("0.###", CultureInfo.InvariantCulture);

    private readonly record struct ArcSegment(string Path, string Color);
    private readonly record struct TickMark(string X1, string Y1, string X2, string Y2);
}
